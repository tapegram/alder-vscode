{
  "name": "alder",
  "displayName": "Alder",
  "description": "Alder language support: the alder lsp server in VS Code",
  "publisher": "tapegram",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tapegram/alder-vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:alder"
  ],
  "contributes": {
    "languages": [
      {
        "id": "alder",
        "aliases": [
          "Alder",
          "alder"
        ],
        "extensions": [
          ".alder"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alder",
        "scopeName": "source.alder",
        "path": "./syntaxes/alder.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "tag",
        "superType": "type",
        "description": "An element's tag name"
      },
      {
        "id": "attribute",
        "superType": "type",
        "description": "An element's attribute name"
      },
      {
        "id": "boolean",
        "superType": "enumMember",
        "description": "True or False"
      },
      {
        "id": "hole",
        "superType": "variable",
        "description": "A typed hole (?h)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "alder",
        "scopes": {
          "tag": [
            "entity.name.tag.alder"
          ],
          "attribute": [
            "entity.other.attribute-name.alder"
          ],
          "boolean": [
            "constant.language.boolean.alder"
          ],
          "hole": [
            "variable.language.hole.alder"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[alder]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "compile": "tsc -p .",
    "lint": "tsc -p . --noEmit && eslint .",
    "test:unit": "tsc -p . && node --test \"out/test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && tsc -p . && node out/test/e2e/run.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
