{
  "comments": { "lineComment": "--" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "wordPattern": "[A-Za-z_][\\w']*|\\?[a-z]\\w*",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{|\\[|\\(|=|->|<-|\\bthen|\\belse)\\s*$|^\\s*<[A-Za-z][\\w.-]*(\\s[^>]*[^/>])?>\\s*$",
    "decreaseIndentPattern": "^\\s*(\\}|\\]|\\)|else\\b|</)"
  },
  "onEnterRules": [
    {
      "beforeText": "(\\|>|\\?\\?|\\|\\||&&|\\+\\+|==|!=|<=|>=|[+\\-*/])\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
